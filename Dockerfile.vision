FROM python:3.11-slim AS model-builder

WORKDIR /build
RUN apt-get update \
    && apt-get install -y --no-install-recommends git libgomp1 \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir torch==2.3.1 torchvision==0.18.1 --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir timm==1.0.11 onnx==1.17.0
RUN git init /tmp/calorai \
    && git -C /tmp/calorai remote add origin https://github.com/MiaoE/CalorAI.git \
    && git -C /tmp/calorai fetch --depth 1 origin 154da88524411a6c45feed8a206dc2ab613352d6 \
    && git -C /tmp/calorai checkout FETCH_HEAD
COPY scripts/export_calorai_onnx.py /build/export_calorai_onnx.py
RUN OMP_NUM_THREADS=1 python /build/export_calorai_onnx.py /tmp/calorai /build/model

FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV FOOD_VISION_MODEL_DIR=/app/food-vision-model
ENV OMP_NUM_THREADS=1
ENV MKL_NUM_THREADS=1

WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir onnxruntime==1.22.1 Pillow==10.4.0
COPY --from=model-builder /build/model /app/food-vision-model
COPY backend ./backend
COPY src ./src

EXPOSE 8000
CMD ["python", "-m", "uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
