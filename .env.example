IR_ENV=production
IR_API_VERSION=0.2.0
# Leave DATABASE_URL unset for local SQLite. Set it in production for Postgres.
# DATABASE_URL=postgresql://user:password@host:5432/database
IR_APP_DB_PATH=backend/app.db
IR_MODEL_PATH=/app/backend/model_artifacts/reduced_lightgbm_bundle.joblib
IR_ALLOWED_ORIGINS=https://your-app.example.com
IR_MAX_BODY_BYTES=5242880
IR_SESSION_DAYS=30
IR_AUTH_WINDOW_SECONDS=60
IR_AUTH_MAX_REQUESTS=12
IR_ENABLE_DOCS=false

# Optional: used only for daily insight wording, not food-photo recognition.
# OPENAI_API_KEY=
OPENAI_INSIGHTS_MODEL=gpt-4o-mini

# Local MIT-licensed CalorAI weights for food-photo recognition and portion grams.
# FOOD_VISION_MODEL_DIR=/absolute/path/to/calorai-model

# USDA nutrition values are bundled locally; no API key is required.
# USDA_OFFLINE_DB_PATH=/absolute/path/to/usda_foods.sqlite
